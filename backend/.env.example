# Copy this file to `.env` and adjust values

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nanny

# JWT
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Server
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Optional email delivery for order confirmations
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Payment provider
PAYMENT_PROVIDER=demo

# Optional SMS delivery through Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
