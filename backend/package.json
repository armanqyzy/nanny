{
  "name": "nanny-backend",
  "version": "1.0.0",
  "description": "Backend API for the Nanny pet-care platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --legacy-watch src/server.js",
    "db:init": "psql $DATABASE_URL -f db/schema.sql && psql $DATABASE_URL -f db/seed.sql",
    "db:activity": "node scripts/seed-activity.js",
    "db:docker:up": "docker compose -f ../docker-compose.yml up -d db",
    "db:docker:down": "docker compose -f ../docker-compose.yml down",
    "db:docker:logs": "docker compose -f ../docker-compose.yml logs -f db",
    "db:docker:status": "docker compose -f ../docker-compose.yml ps db"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "nodemailer": "^8.0.5",
    "pg": "^8.12.0",
    "socket.io": "^4.7.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
